# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string.
# For local development: postgresql://user:password@localhost:5432/bumba_db
# For Render: automatically injected from the linked database.
DATABASE_URL="postgresql://user:password@localhost:5432/bumba_db"
